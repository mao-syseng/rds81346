---
import { Button } from "@/components/ui/button"
---

<section class="relative py-20 sm:py-28 lg:py-32 bg-background">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      {/* Eyebrow */}
      <div class="mb-8">
        <span class="inline-block text-sm font-semibold uppercase tracking-wider text-primary">
          Get Started with RDS 81346
        </span>
      </div>

      {/* Heading */}
      <h2 class="text-4xl sm:text-5xl font-bold tracking-tight mb-8 leading-tight">
        Better engineering starts with better structure.
      </h2>

      {/* Description */}
      <p class="text-lg text-muted-foreground leading-relaxed mb-12">
        Whether you're developing a new facility, managing existing assets, or improving collaboration
        across engineering teams, a common reference designation system provides the foundation for lasting
        clarity.
      </p>

      {/* CTAs */}
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <Button size="lg" className="px-8">
          Explore the Standard
        </Button>
        <Button size="lg" variant="outline" className="px-8">
          Get Started
        </Button>
      </div>
    </div>
  </div>
</section>
